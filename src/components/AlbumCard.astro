---
// src/components/AlbumCard.astro
interface Props {
  titulo: string;
  descripcion?: string | null;
  urlPortada?: string | null;
  urlAlbum?: string | null;
  interactive?: boolean; // false = solo vista, sin link (preview admin)
}

const {
  titulo,
  descripcion = null,
  urlPortada = null,
  urlAlbum = null,
  interactive = true,
} = Astro.props;

const Tag = interactive && urlAlbum ? 'a' : 'div';
const linkProps = interactive && urlAlbum
  ? { href: urlAlbum, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-shadow duration-300',
    interactive && 'hover:shadow-lg cursor-pointer',
  ]}
>
  <div class="aspect-4/3 w-full overflow-hidden bg-slate-100">
    {urlPortada ? (
      <img
        data-card-img
        src={urlPortada}
        alt={titulo}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div data-card-placeholder class="flex h-full w-full items-center justify-center text-slate-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 8.25V15a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 15V8.25m-18 0A2.25 2.25 0 015.25 6h13.5A2.25 2.25 0 0121 8.25m-18 0v.008A2.25 2.25 0 005.25 10.5h13.5a2.25 2.25 0 002.25-2.25V8.25" />
        </svg>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <span class="text-xs font-bold uppercase tracking-widest text-cyan-600">Álbum</span>
    <h3 data-card-titulo class="mt-1 text-xl font-bold text-slate-900">
      {titulo || 'Título del álbum'}
    </h3>
    <p data-card-descripcion class:list={['mt-2 flex-1 text-sm text-slate-600 line-clamp-2', !descripcion && 'hidden']}>
      {descripcion}
    </p>
    {interactive && (
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-cyan-600">
        Ver álbum
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
      </span>
    )}
  </div>
</Tag>