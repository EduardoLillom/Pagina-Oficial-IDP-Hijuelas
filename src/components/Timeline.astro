---
import { getHitos } from '../lib/hitos';

const hitos = await getHitos(Astro.locals.supabase);

const formatearFecha = (fecha: string) =>
  new Date(fecha).toLocaleDateString('es-CL', { month: 'long', year: 'numeric' });
---
<section class="py-16 px-4 max-w-4xl mx-auto">
  <h2 class="font-heading text-3xl text-idp-azul text-center mb-2">Avances de nuestro templo</h2>
  <p class="font-serif italic text-idp-purpura text-center mb-12">Paso a paso, construyendo nuestra casa</p>

  <div class="relative">
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-idp-azul/20 md:-translate-x-1/2"></div>

    <div class="space-y-12">
      {hitos.map((h, i) => (
        <div class={`relative flex flex-col md:flex-row items-start md:items-center gap-6 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
          <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-idp-dorado rounded-full border-4 border-white shadow -translate-x-1/2 z-10"></div>

          <div class="w-full md:w-1/2 pl-12 md:pl-0 md:px-8">
            <div class="bg-white rounded-xl shadow-md p-5 border border-idp-azul/10 border-t-4 border-t-idp-azul">
              {h.url_imagen && (
                <img src={h.url_imagen} alt={h.titulo} class="w-full h-40 object-cover rounded-lg mb-3" />
              )}
              <p class="font-serif italic text-idp-dorado text-sm font-semibold uppercase tracking-wide">
                {formatearFecha(h.fecha)}
              </p>
              <h3 class="font-heading text-lg text-idp-azul mt-1">{h.titulo}</h3>
              {h.descripcion && <p class="font-sans text-gray-600 text-sm mt-2">{h.descripcion}</p>}
            </div>
          </div>

          <div class="hidden md:block w-1/2"></div>
        </div>
      ))}
    </div>
  </div>
</section>