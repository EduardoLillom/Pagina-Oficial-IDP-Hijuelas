---
// src/components/Navbar.astro
import { Image } from 'astro:assets';
import logoIdp from '../assets/logos/logo.webp'

export const prerender = true;
const pathname = Astro.url.pathname;
const navItems = [
  { to: '/', label: 'Inicio' },
  { 
    label: 'Sobre Nosotros', 
    dropdown: [
      { 
        title: 'Conócenos', links: [
          { to: '/quienes-somos', label: 'Quiénes somos' }, 
          { to: '/doctrina', label: 'Doctrina' },
          { to: '/valores', label: 'Nuestros Valores'},
          { to: '/lideres', label: 'Nuestros Líderes'}
        ] 
      },
    ] 
  },
  { to: '/horarios', label: 'Horarios'},
  { to: '/galeria', label: 'Galería' },
  { to: '/eventos', label: 'Eventos' },
  { to: '/nuestro-templo', label: 'Nuestro Templo' },
  { to: '/contacto', label: 'Contacto' },
];
---

<header class="fixed top-4 left-0 right-0 z-50 px-2 sm:px-4">
  <div class="mx-auto flex max-w-5xl items-center justify-between rounded-full border border-idp-dorado/30 bg-white/90 px-4 py-3 shadow-[0_10px_30px_rgba(23,33,114,0.1)] backdrop-blur-xl">
    
    <!-- Logo y Título -->
    <a href="/" class="flex items-center gap-2 pl-2 shrink-0 group">
      <Image src={logoIdp} alt="Logo IDP Hijuelas" class="h-9 w-9 shrink-0 sm:h-10 sm:w-10 object-contain" />
      <div class="flex flex-col min-w-0">
        <p class="font-headline text-xs font-bold text-idp-azul truncate group-hover:text-idp-rojo transition-colors">IDP Hijuelas</p>
        <p class="font-highlight text-[10px] uppercase tracking-[0.2em] text-idp-purpura truncate">Fe, unidad y santidad</p>
      </div>
    </a>

    <!-- Menú de Escritorio -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
      {navItems.map((item) => (
        item.dropdown ? (
          <div class="relative group" tabindex="0">
            <button class="flex items-center gap-1 font-sans font-medium hover:text-idp-rojo transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <span class="text-[8px] opacity-60 group-hover:rotate-180 transition-transform text-idp-purpura">▼</span>
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+12px)] w-max min-w-48 rounded-2xl bg-idp-azul p-4 text-white shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-50 border border-idp-dorado/30">
              {item.dropdown.map((col) => (
                <ul class="flex flex-col gap-2">
                  {col.links.map((link) => (
                    <li>
                      <a href={link.to} class="font-sans font-light text-sm text-slate-200 hover:text-idp-dorado hover:bg-white/10 px-3 py-1.5 rounded-lg transition-colors block">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.to} class={`font-sans font-medium transition-colors ${pathname === item.to ? 'text-idp-rojo font-bold' : 'hover:text-idp-rojo text-slate-700'}`}>
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Botón Menú Móvil -->
    <button id="menu-toggle" class="md:hidden p-2 rounded-full hover:bg-idp-azul/10 transition-colors text-idp-azul" aria-label="Abrir menú">
      <span id="menu-icon" class="text-xl font-bold">≡</span>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden absolute top-full left-2 right-2 mt-2 rounded-3xl border border-idp-dorado/40 bg-white/95 p-6 shadow-2xl backdrop-blur-xl md:hidden transition-all duration-300">
    <nav class="flex flex-col gap-4">
      {navItems.map((item) => (
        item.dropdown ? (
          <div>
            <p class="font-highlight text-[10px] font-bold text-idp-purpura uppercase tracking-widest mb-2">{item.label}</p>
            {item.dropdown.flatMap(col => col.links).map(link => (
              <a href={link.to} class="font-sans py-2 text-slate-700 pl-4 border-l-2 border-idp-purpura/30 hover:border-idp-rojo hover:text-idp-rojo transition-colors block">{link.label}</a>
            ))}
          </div>
        ) : (
          <a href={item.to} class="font-sans py-2 text-base font-semibold text-idp-azul hover:text-idp-rojo transition-colors">{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>

<script>
  function setupMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    toggleBtn?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      if (menuIcon) menuIcon.textContent = isHidden ? '≡' : '×';
    });

    // Cerrar menú al hacer clic en un enlace
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        if (menuIcon) menuIcon.textContent = '≡';
      });
    });
  }
  setupMenu();
  document.addEventListener('astro:after-swap', setupMenu);
</script>