---
// src/components/LeaderCard.astro
const { leader, priority = "normal" } = Astro.props;
import { Image } from 'astro:assets';

const imagePos = leader.imagePosition ?? "object-top";
---

<div class="group bg-white rounded-3xl border border-idp-dorado/30 shadow-md overflow-hidden hover:shadow-xl hover:border-idp-dorado transition-all duration-300 hover:-translate-y-1 flex flex-col h-full w-full min-w-0">  
  <!-- Imagen optimizada -->
  <div class="aspect-4/3 overflow-hidden bg-idp-azul/5">
    <Image 
      src={leader.image} 
      alt={leader.name}
      inferSize={true}
      loading={priority === "high" ? "eager" : "lazy"}
      class={`w-full ${imagePos} h-full object-cover transition-transform duration-500 group-hover:scale-105`}
    />
  </div>
  
  <div class="p-7 flex-1 flex flex-col">
    <span class="font-highlight text-xs uppercase tracking-[0.5px] text-idp-rojo font-bold mb-2">
      {leader.role}
    </span>
    <h3 class="font-headline text-2xl font-bold text-idp-azul mb-4">{leader.name}</h3>
    <p class="font-sans font-light text-slate-600 leading-relaxed text-[15.2px] flex-1">
      {leader.description}
    </p>
  </div>
</div>