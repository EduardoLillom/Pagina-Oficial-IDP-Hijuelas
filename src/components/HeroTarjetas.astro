---
// src/components/HeroTarjetas.astro
import { getTarjetasPublicas, renderContenidoHtml } from '../lib/tarjetasHero';
import 'swiper/css';
import 'swiper/css/navigation';

const tarjetas = await getTarjetasPublicas(Astro.locals.supabase);

const ETIQUETAS: Record<string, string> = {
  aviso: 'Aviso',
  noticia: 'Noticia',
  evento: 'Evento',
};

const ESTILOS_TIPO: Record<string, { badge: string; link: string; boton: string }> = {
  aviso: {
    badge: 'text-idp-azul bg-idp-dorado/20',
    link: 'text-idp-azul hover:text-idp-rojo',
    boton: 'bg-idp-dorado text-idp-azul hover:brightness-95',
  },
  noticia: {
    badge: 'text-idp-azul bg-idp-azul/10',
    link: 'text-idp-azul hover:text-idp-rojo',
    boton: 'bg-idp-azul text-white hover:bg-idp-azul/90',
  },
  evento: {
    badge: 'text-idp-purpura bg-idp-purpura/10',
    link: 'text-idp-purpura hover:text-idp-rojo',
    boton: 'bg-idp-purpura text-white hover:bg-idp-purpura/90',
  },
};

const formatFechaEvento = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })
    : null;
---

{tarjetas.length > 0 && (
  <section id="destacados" class="relative z-30 px-4 pb-12 transition-all duration-700 ease-out">
    <div class="mx-auto max-w-4xl">

      <!-- El propio elemento .swiper es ahora la tarjeta visual: menos -->
      <!-- anidamiento entre "contenedor con estilos" y "contenedor swiper" -->
      <!-- reduce el riesgo de que ambos midan anchos distintos. -->
      <div
        class="hero-swiper swiper overflow-hidden rounded-4xl border border-idp-dorado/30 bg-white/90 p-6 shadow-[0_20px_50px_rgba(23,33,114,0.1)] backdrop-blur-xl md:p-10"
        role="region"
        aria-roledescription="carousel"
        aria-label="Destacados"
      >

        <div class="swiper-wrapper">
          {tarjetas.map((t) => {
            const estilo = ESTILOS_TIPO[t.tipo];
            return (
              <div class="swiper-slide">
                <div class="flex min-h-64 flex-col items-center justify-center py-2 text-center">
                  <div class="w-full max-w-xl px-4 md:px-6">
                    {t.tipo === 'cita' ? (
                      <div class="relative">
                        <span class="absolute -top-6 left-1/2 -translate-x-1/2 select-none font-serif text-6xl leading-none text-idp-dorado" aria-hidden="true">“</span>
                        <p class="pt-4 font-serif text-2xl italic leading-relaxed text-slate-800 md:text-3xl">{t.contenido}</p>
                        {t.cita_referencia && (
                          <p class="mt-3 font-sans text-sm font-bold tracking-wide text-idp-purpura">{t.cita_referencia}</p>
                        )}
                      </div>
                    ) : (
                      <div class="space-y-4">
                        <span class:list={['rounded-full px-3 py-1 font-sans text-[10px] font-black uppercase tracking-[0.2em]', estilo.badge]}>
                          {ETIQUETAS[t.tipo]}
                        </span>
                        <h3 class="font-heading text-2xl font-extrabold leading-tight text-slate-900">{t.titulo}</h3>

                        <div class="prose prose-sm line-clamp-3 max-w-none font-sans text-slate-600" set:html={renderContenidoHtml(t.contenido)} />

                        {t.tipo === 'evento' && t.fecha_evento && (
                          <p class="flex items-center justify-center gap-1.5 font-sans text-sm font-semibold text-idp-purpura">
                            <span aria-hidden="true">📅</span> {formatFechaEvento(t.fecha_evento)}
                          </p>
                        )}

                        {t.botones && t.botones.length > 0 && (
                          <div class="flex flex-wrap justify-center gap-3 pt-1">
                            {t.botones.map((b, bi) => (
                              bi === 0 ? (
                                <a href={b.url} class:list={['rounded-full px-5 py-2.5 font-sans text-sm font-bold shadow-sm transition', estilo.boton]}>
                                  {b.texto} →
                                </a>
                              ) : (
                                <a href={b.url} class:list={['border-b font-sans text-sm font-bold', estilo.link]}>
                                  {b.texto} →
                                </a>
                              )
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {tarjetas.length > 1 && (
          <div class="mt-8 flex items-center justify-center gap-6">
            <button class="hero-prev flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-lg font-bold text-idp-azul/50 transition hover:text-idp-rojo focus-visible:outline focus-visible:outline-idp-azul focus-visible:outline-offset-2" aria-label="Tarjeta anterior">←</button>
            <div class="hero-pagination flex items-center gap-2" role="tablist" aria-label="Seleccionar tarjeta">
              {tarjetas.map((_, i) => (
                <button
                  type="button"
                  class="hero-bullet h-2.5 w-2.5 shrink-0 rounded-full bg-idp-azul transition-all duration-200 focus-visible:outline focus-visible:outline-idp-azul focus-visible:outline-offset-2"
                  data-slide-index={i}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={`Ir a la tarjeta ${i + 1} de ${tarjetas.length}`}
                />
              ))}
            </div>
            <button class="hero-next flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-lg font-bold text-idp-azul/50 transition hover:text-idp-rojo focus-visible:outline focus-visible:outline-idp-azul focus-visible:outline-offset-2" aria-label="Tarjeta siguiente">→</button>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .hero-bullet {
    opacity: 0.2;
  }
  .hero-bullet.is-active {
    background: var(--color-idp-rojo);
    opacity: 1;
    transform: scale(1.25);
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay, A11y, Keyboard } from 'swiper/modules';

  function initHeroSwiper() {
    const el = document.querySelector<HTMLElement>('.hero-swiper');
    if (!el) return;

    if ((el as any).swiper) return;

    const bullets = Array.from(el.querySelectorAll<HTMLButtonElement>('.hero-bullet'));

    const setActiveBullet = (index: number) => {
      bullets.forEach((bullet, i) => {
        const active = i === index;
        bullet.classList.toggle('is-active', active);
        bullet.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    const swiper = new Swiper(el, {
      modules: [Navigation, Autoplay, A11y, Keyboard],
      loop: true,
      slidesPerView: 1,
      centeredSlides: true, // fuerza el centrado del slide activo pase lo que pase con el cálculo de ancho
      speed: 400,
      observer: true,
      observeParents: true,
      autoplay: {
        delay: 6000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      keyboard: { enabled: true },
      a11y: {
        prevSlideMessage: 'Tarjeta anterior',
        nextSlideMessage: 'Tarjeta siguiente',
        slideLabelMessage: 'Tarjeta {{index}} de {{slidesLength}}',
      },
      navigation: {
        prevEl: '.hero-prev',
        nextEl: '.hero-next',
      },
      on: {
        slideChange: (sw) => setActiveBullet(sw.realIndex),
      },
    });

    bullets.forEach((bullet, i) => {
      bullet.addEventListener('click', () => swiper.slideToLoop(i));
    });
    setActiveBullet(swiper.realIndex);

    const resnap = () => {
      swiper.update();
      swiper.slideToLoop(swiper.realIndex, 0, false);
    };
    if ('fonts' in document) {
      document.fonts.ready.then(resnap);
    }
    window.addEventListener('load', resnap);
  }

  // Animación de scroll (independiente del swiper)
  function initScrollAnim() {
    const section = document.getElementById('destacados');
    if (!section) return;

    let hasMoved = false;
    window.addEventListener('scroll', () => {
      if (window.scrollY > 150 && !hasMoved) {
        section.classList.add('-mt-24', 'animate-fade-up', 'animate-duration-1000');
        hasMoved = true;
      } else if (window.scrollY <= 150 && hasMoved) {
        section.classList.remove('-mt-24', 'animate-fade-up', 'animate-duration-1000');
        hasMoved = false;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initHeroSwiper();
    initScrollAnim();
  });
</script>