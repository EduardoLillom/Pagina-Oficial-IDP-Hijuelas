  <!-- Titular con Aktiv Grotesk Ex -->
  <h2 class="font-heading text-3xl font-bold tracking-tight text-idp-azul sm:text-4xl">
    {title}
  </h2>
  <!-- Línea decorativa con el color rojo institucional -->
  <div class="mt-2 h-1 w-12 rounded-full bg-idp-rojo"></div>
</div>