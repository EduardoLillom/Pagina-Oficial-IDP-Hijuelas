---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import HomeImage from '../assets/home.webp'
---

<header class="relative min-h-screen overflow-hidden bg-idp-azul text-white flex items-center justify-center">
  {/* Fondo visual con capas y gradientes institucionales (Azul y Púrpura con sutil acento dorado) */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(237,199,50,0.16),transparent_35%),linear-gradient(180deg,rgba(23,33,114,0.1),rgba(75,39,135,0.1))] z-10" />
  
  <div class="absolute inset-0 z-0">
    <Image
      src={HomeImage}
      alt="Iglesia de Dios de la Profecía"
      class="w-full h-full object-cover opacity-35"
      loading="eager"
    />
  </div>

  <div class="relative z-20 mx-auto flex flex-col items-center px-4 pt-24 py-24 sm:px-6 lg:px-8 w-full max-w-4xl">
    
    {/* Contenido de Bienvenida */}
    <div class="text-center space-y-6 mb-16">
      <p class="font-highlight text-sm uppercase tracking-[0.35em] text-idp-dorado font-semibold">
        Iglesia de Dios de la Profecía
      </p>
      <h1 class="font-headline text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Una comunidad viva, de fe, servicio y encuentro.
      </h1>

      {/* Botones de Navegación Principal (UX: Prioridad visual con Rojo institucional y Dorado) */}
      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a 
          href="/doctrina/" 
          class="bg-idp-rojo hover:opacity-90 text-white px-8 py-3 rounded-full font-sans font-bold transition-all transform hover:scale-105 shadow-md"
        >
          Nuestras Doctrinas
        </a>
        <a 
          href="/valores" 
          class="bg-transparent border border-idp-dorado/60 hover:bg-idp-dorado/10 text-idp-dorado px-8 py-3 rounded-full font-sans font-semibold transition-all"
        >
          Nuestros Valores
        </a>
      </div>
    </div>
  </div>

  {/* Flecha de desplazamiento inferior */}
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce cursor-pointer z-20">
    <a href="#destacados" class="text-idp-dorado/80 hover:text-idp-dorado transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>  
</header>