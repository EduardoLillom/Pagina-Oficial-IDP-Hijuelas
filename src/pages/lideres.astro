---
// src/pages/liderazgo.astro
export const prerender = true;
import { Image } from 'astro:assets';
import BaseLayout from "../layouts/BaseLayout.astro";
import LeaderCard from "../components/LeaderCard.astro";
import { pastoralTeam, ministriesWithTeam, adminTeam, committees, logistics, sections } from '../consts/leadership.ts';

// Genera iniciales para el avatar de respaldo cuando no hay foto real
function initials(name: string) {
  return name.split(" ").filter(Boolean).slice(0, 2).map(n => n[0]).join("").toUpperCase();
}
---

<BaseLayout pageTitle="Nuestro Liderazgo">

  <!-- === HEADER DE PÁGINA === -->
  <section class="pt-32 sm:pt-40 pb-10 bg-linear-to-b from-idp-azul/5 to-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-idp-rojo/10 border border-idp-rojo/20 mb-6">
        <span class="w-2 h-2 rounded-full bg-idp-rojo animate-pulse"></span>
        <!-- Texto resaltado con Berkeley Oldstyle -->
        <span class="font-serif text-xs uppercase tracking-widest text-idp-rojo font-bold">
          Iglesia de Dios de la Profecía • Hijuelas
        </span>
      </div>
      <!-- Titular con Aktiv Grotesk Ex -->
      <h1 class="font-heading text-4xl sm:text-6xl font-extrabold text-idp-azul mb-6 tracking-tight">
        Nuestro Liderazgo
      </h1>
      <!-- Cuerpo de texto con Nunito Sans -->
      <p class="font-sans font-light text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Conoce al equipo comprometido que Dios ha levantado para guiar, servir y edificar a nuestra congregación.
      </p>
    </div>
  </section>

  <!-- === CONTENIDO PRINCIPAL === -->
  <section class="bg-idp-azul/5 pt-4 pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-28">

      <!-- === NAVEGACIÓN INTERNA (sticky) === -->
      <nav
        aria-label="Secciones de liderazgo"
        class="flex flex-nowrap md:flex-wrap gap-2 justify-start md:justify-center overflow-x-auto md:overflow-visible sticky top-24 z-20 bg-white/80 backdrop-blur-md py-4 px-4 -mx-4 md:mx-0 md:px-0 rounded-2xl shadow-xs border border-idp-dorado/30 scrollbar-hide"
      >
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="whitespace-nowrap px-5 py-2.5 bg-white border border-idp-dorado/30 rounded-full font-sans text-sm font-semibold text-idp-azul hover:border-idp-rojo hover:text-idp-rojo transition-all shadow-xs focus-visible:outline focus-visible:outline-idp-azul"
          >
            {s.label}
          </a>
        ))}
      </nav>

      <!-- === EQUIPO PASTORAL === -->
      <div id="pastoral" class="scroll-mt-45 md:scroll-mt-55">
        <div class="flex items-center gap-4 mb-10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-6 bg-idp-rojo rounded-full"></span>
            <!-- Titular con Aktiv Grotesk Ex -->
            <h2 class="font-heading text-2xl font-bold text-idp-azul tracking-tight">Equipo Pastoral</h2>
          </div>
          <span class="h-px flex-1 bg-idp-dorado/40"></span>
        </div>

        <div class="flex flex-wrap justify-center gap-8">
          {pastoralTeam.map((leader, index) => (
            <div class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.35rem)] max-w-sm transition-transform duration-300 hover:-translate-y-1">
              <LeaderCard leader={leader} priority={index === 0 ? "high" : "normal"} />
            </div>
          ))}
        </div>
      </div>

      <!-- === MINISTERIOS === -->
      <div id="ministerios" class="scroll-mt-45 md:scroll-mt-55">
        <div class="flex items-center gap-4 mb-10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-6 bg-idp-rojo rounded-full"></span>
            <!-- Titular con Aktiv Grotesk Ex -->
            <h2 class="font-heading text-2xl font-bold text-idp-azul tracking-tight">Liderazgo de Ministerios</h2>
          </div>
          <span class="h-px flex-1 bg-idp-dorado/40"></span>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 justify-center">
          {ministriesWithTeam.map((ministry) => (
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-idp-dorado/30 flex flex-col justify-between hover:shadow-xl hover:border-idp-dorado transition-all duration-300 mx-auto w-full max-w-sm lg:max-w-none">
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <!-- Texto resaltado con Berkeley Oldstyle -->
                  <span class="font-serif text-xs font-bold uppercase tracking-wider text-idp-rojo bg-idp-rojo/10 px-3 py-1 rounded-full inline-block">
                    {ministry.ministryName}
                  </span>
                  {ministry.leader.dualRole && (
                    <span
                      class="font-sans text-[11px] font-medium text-slate-400"
                      title="Esta persona también lidera otra área"
                    >
                      + otra área
                    </span>
                  )}
                </div>
                <div class="mt-2">
                  {ministry.leader.image ? (
                    <LeaderCard leader={ministry.leader} />
                  ) : (
                    <div class="flex items-center gap-4">
                      <div
                        class="flex-0 w-14 h-14 rounded-full bg-idp-azul/10 text-idp-azul font-heading font-bold flex items-center justify-center text-lg border border-idp-azul/20"
                        aria-hidden="true"
                      >
                        {initials(ministry.leader.name)}
                      </div>
                      <div>
                        <!-- Titular con Aktiv Grotesk Ex -->
                        <p class="font-heading font-bold text-slate-900 text-sm">{ministry.leader.name}</p>
                        <!-- Cuerpo de texto con Nunito Sans -->
                        <p class="font-sans text-slate-500 text-xs">{ministry.leader.role}</p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- === EQUIPO ADMINISTRATIVO === -->
      <div id="administracion" class="scroll-mt-45 md:scroll-mt-55">
        <div class="flex items-center gap-4 mb-10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-6 bg-idp-rojo rounded-full"></span>
            <!-- Titular con Aktiv Grotesk Ex -->
            <h2 class="font-heading text-2xl font-bold text-idp-azul tracking-tight">Equipo Administrativo</h2>
          </div>
          <span class="h-px flex-1 bg-idp-dorado/40"></span>
        </div>

        <div class="flex flex-wrap justify-center gap-8 max-w-4xl mx-auto">
          {adminTeam.map((leader) => (
            <div class="w-full md:w-[calc(50%-1rem)] max-w-sm transition-transform duration-300 hover:-translate-y-1">
              <LeaderCard leader={leader} priority="normal" />
            </div>
          ))}
        </div>
      </div>

      <!-- === COMITÉS Y DIRECTORIO === -->
      <div id="comites" class="scroll-mt-45 md:scroll-mt-55">
        <div class="flex items-center gap-4 mb-10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-6 bg-idp-rojo rounded-full"></span>
            <!-- Titular con Aktiv Grotesk Ex -->
            <h2 class="font-heading text-2xl font-bold text-idp-azul tracking-tight">Comités de Trabajo</h2>
          </div>
          <span class="h-px flex-1 bg-idp-dorado/40"></span>
        </div>

        <div class="grid md:grid-cols-2 gap-8 justify-center items-stretch">
          {committees.map((committee) => (
            <div class="bg-white rounded-3xl shadow-sm border border-idp-dorado/30 overflow-hidden flex flex-col mx-auto w-full max-w-xl h-full hover:shadow-xl transition-all duration-300">
              {committee.image ? (
                <div class="relative h-48 sm:h-56 w-full overflow-hidden bg-slate-100">
                  <Image
                    src={committee.image}
                    alt={committee.title}
                    class={`w-full h-full object-contain sm:object-cover ${committee.imagePosition || 'object-center'}`}
                  />
                  <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent flex items-end p-6">
                    <!-- Texto resaltado con Berkeley Oldstyle -->
                    <span class="font-serif text-xs font-bold uppercase tracking-wider text-idp-dorado bg-idp-azul/80 backdrop-blur-md px-3 py-1 rounded-full border border-idp-dorado/40">
                      Directorio
                    </span>
                  </div>
                </div>
              ) : (
                <div class="h-48 sm:h-56 w-full bg-linear-to-br from-idp-azul/10 to-white flex items-end p-6 border-b border-idp-dorado/20">
                  <!-- Texto resaltado con Berkeley Oldstyle -->
                  <span class="font-serif text-xs font-bold uppercase tracking-wider text-idp-purpura bg-white px-3 py-1 rounded-full shadow-xs">
                    Comité
                  </span>
                </div>
              )}

              <div class="p-6 sm:p-8 flex-1">
                <!-- Titular con Aktiv Grotesk Ex -->
                <h3 class="font-heading text-lg font-bold text-idp-azul mb-6 pb-3 border-b border-slate-100">
                  {committee.title}
                </h3>
                <ul class="space-y-4">
                  {committee.members.map((member) => (
                    <li class="flex items-center justify-between text-sm py-1.5 border-b border-slate-50 last:border-0">
                      <!-- Cuerpo de texto con Nunito Sans -->
                      <span class="font-sans font-medium text-slate-800">{member.name}</span>
                      <!-- Texto resaltado con Berkeley Oldstyle -->
                      <span class="font-serif text-idp-purpura font-bold bg-idp-purpura/10 px-3 py-1 rounded-full text-xs">
                        {member.role}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- === LOGÍSTICA Y ÁREAS DE APOYO === -->
      <div id="Apoyo" class="scroll-mt-45 md:scroll-mt-55">
        <div class="flex items-center gap-4 mb-10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-6 bg-idp-rojo rounded-full"></span>
            <!-- Titular con Aktiv Grotesk Ex -->
            <h2 class="font-heading text-2xl font-bold text-idp-azul tracking-tight">Áreas de Apoyo y Servicio</h2>
          </div>
          <span class="h-px flex-1 bg-idp-dorado/40"></span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 justify-center">
          {logistics.map((item) => (
            <div class="bg-white rounded-2xl shadow-sm border border-idp-dorado/30 overflow-hidden hover:border-idp-dorado hover:shadow-xl transition-all duration-300 mx-auto w-full max-w-sm sm:max-w-none flex flex-col">
              {item.image && (
                <div class="relative h-40 w-full overflow-hidden bg-slate-100">
                  <Image
                    src={item.image}
                    alt={item.name}
                    class={`w-full h-full object-cover ${item.imagePosition || 'object-center'}`}
                  />
                </div>
              )}
              <div class="p-5 flex flex-col justify-between grow">
                <!-- Titular con Aktiv Grotesk Ex -->
                <p class="font-heading text-slate-800 font-bold text-sm mb-1">{item.name}</p>
                <!-- Texto resaltado con Berkeley Oldstyle -->
                <span class="font-serif text-xs uppercase tracking-wider text-idp-rojo font-bold block">{item.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  html {
    scroll-behavior: smooth;
  }
</style>