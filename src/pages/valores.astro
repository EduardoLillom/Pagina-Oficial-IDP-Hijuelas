---
// src/pages/valores.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import AccordionCard from "../components/AccordionCard.astro"
import { valores } from "../consts/valores.ts";
---

<BaseLayout 
  pageTitle="Nuestros Valores"
  description="Descubre los valores centrales que guían a la Iglesia de Dios de la Profecía en Hijuelas. Principios de integridad, servicio y amor que definen nuestra identidad."
>
  <section class="py-20 bg-idp-azul/5 min-h-screen">
    <div class="max-w-5xl pt-32 mx-auto px-4">
      
      <!-- Eyebrow y Título -->
      <div class="text-center mb-6">
        <!-- Texto resaltado con Berkeley Oldstyle -->
        <p class="font-serif text-xs uppercase tracking-[0.28em] text-idp-rojo font-bold mb-3">Principios Fundamentales</p>
        <!-- Titular con Aktiv Grotesk Ex -->
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-idp-azul">Nuestros Valores Centrales</h2>
      </div>
      
      <!-- Texto introductorio con Nunito Sans -->
      <p class="font-sans font-light max-w-2xl mx-auto text-center text-slate-600 mb-12 text-base md:text-lg leading-relaxed">
        Nuestra misión fluye directamente de nuestros valores centrales y los afirma en sus llamados. 
        Los valores centrales de la Iglesia de Dios de la Profecía son:
      </p>
      
      <!-- Listado con Tarjetas de Acordeón -->
      <div class="space-y-4">
        {valores.map((item) => (
          <AccordionCard 
            title={item.title} 
            text={item.text} 
            icon={item.icon}
          />
        ))}
      </div>
      
    </div>
  </section>
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>