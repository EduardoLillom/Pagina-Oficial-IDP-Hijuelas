---
// src/pages/galeria.astro

import BaseLayout from '../layouts/BaseLayout.astro';
import { getAlbumes } from '../lib/galeria';
import AlbumCard from '../components/AlbumCard.astro';

const albumes = await getAlbumes();
---

<BaseLayout
  pageTitle="Galería | IDP Hijuelas"
  description="Explora nuestra galería de fotos y revive los momentos especiales de la Iglesia de Dios de la Profecía en Hijuelas. Cada álbum captura la esencia de nuestras actividades y celebraciones comunitarias."
>
  <div class="bg-idp-azul/5 min-h-screen pt-28 py-20">
    <div class="max-w-5xl mx-auto px-4">

      <!-- Encabezado -->
      <div class="text-center mb-16">
        <!-- Texto resaltado con Berkeley Oldstyle -->
        <p class="font-serif text-xs uppercase tracking-[0.28em] text-idp-rojo font-bold mb-3">Momentos en Comunidad</p>
        <!-- Titular con Aktiv Grotesk Ex -->
        <h1 class="font-heading text-4xl md:text-6xl font-bold text-idp-azul mb-6">Galería</h1>
        <!-- Cuerpo de texto con Nunito Sans -->
        <p class="font-sans font-light text-slate-600 max-w-2xl mx-auto text-base md:text-lg leading-relaxed">
          Un vistazo a los encuentros, retiros y celebraciones que hemos vivido juntos.
          Cada álbum guarda las fotos completas en Google Photos.
        </p>
      </div>

      <!-- Listado de Álbumes -->
      {albumes && albumes.length > 0 ? (
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {albumes.map((album) => (
            <li>
              <AlbumCard
                titulo={album.titulo}
                descripcion={album.descripcion}
                urlPortada={album.url_portada}
                urlAlbum={album.url_album}
              />
            </li>
          ))}
        </ul>
      ) : (
        <!-- Estado Vacío -->
        <div class="bg-white p-12 rounded-3xl border border-idp-dorado/30 shadow-md text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-idp-purpura/50 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 8.25V15a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 15V8.25m-18 0A2.25 2.25 0 015.25 6h13.5A2.25 2.25 0 0121 8.25m-18 0v.008A2.25 2.25 0 005.25 10.5h13.5a2.25 2.25 0 002.25-2.25V8.25" />
          </svg>
          <!-- Titular con Aktiv Grotesk Ex -->
          <p class="font-heading text-lg font-bold text-idp-azul mt-4">Todavía no hay álbumes publicados.</p>
          <!-- Cuerpo de texto con Nunito Sans -->
          <p class="font-sans font-light text-slate-500 text-sm mt-1">Vuelve pronto para ver las fotos de nuestros próximos encuentros.</p>
        </div>
      )}

    </div>
  </div>
</BaseLayout>