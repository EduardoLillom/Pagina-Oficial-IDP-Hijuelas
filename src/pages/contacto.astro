---
// src/pages/contacto.astro
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Contacto">
  <section class="relative min-h-screen bg-idp-azul/5 py-20 pt-32 overflow-hidden">
    <!-- Fondo decorativo institucional -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-idp-purpura/10 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-96 h-96 bg-idp-dorado/10 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
    
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
      
      <!-- Encabezado -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="font-highlight text-xs uppercase tracking-[0.28em] text-idp-rojo font-bold mb-3">Contacto</p>
        <h1 class="font-headline text-4xl md:text-5xl font-extrabold text-idp-azul tracking-tight">Estamos aquí para ti</h1>
        <p class="font-sans font-light mt-4 text-base md:text-lg text-slate-600 leading-relaxed">
          Ya sea que necesites información, apoyo o quieras ser parte de nuestra comunidad en Hijuelas, estos son nuestros canales oficiales.
        </p>
      </div>

      <!-- Grid de tarjetas -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        
        <!-- Tarjeta: Dirección -->
        <div class="bg-white/90 backdrop-blur-lg border border-idp-dorado/30 p-8 rounded-4xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between">
          <div>
            <div class="text-idp-azul mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <h3 class="font-highlight text-xs font-bold uppercase tracking-wider text-idp-purpura">Nuestro lugar de reunión</h3>
            <p class="font-headline mt-2 text-lg font-bold text-idp-azul">Sede Villa Los Naranjos</p>
          </div>
          <div class="mt-4">
            <span class="inline-block px-3 py-1 bg-idp-dorado/20 text-idp-azul text-[10px] font-bold uppercase tracking-wide rounded-full border border-idp-dorado/40">
              Ubicación temporal
            </span>
          </div>
        </div>

        <!-- Tarjeta: Correo -->
        <div class="bg-white/90 backdrop-blur-lg border border-idp-dorado/30 p-8 rounded-4xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between">
          <div>
            <div class="text-idp-azul mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="font-highlight text-xs font-bold uppercase tracking-wider text-idp-purpura">Escríbenos</h3>
            <p class="font-sans font-medium mt-2 text-base md:text-lg text-slate-800 break-all">idphijuelas2026@gmail.com</p>
          </div>
        </div>

        <!-- Tarjeta: Redes Sociales -->
        <div class="bg-white/90 backdrop-blur-lg border border-idp-dorado/30 p-8 rounded-4xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between">
          <div class="text-idp-azul mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          
          <div>
            <h3 class="font-highlight text-xs font-bold uppercase tracking-wider text-idp-purpura">Comunidad</h3>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="https://www.instagram.com/idphijuelas/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-idp-azul text-white rounded-full text-xs font-sans font-semibold hover:bg-idp-rojo transition-colors shadow-xs">Instagram</a>
              <a href="https://www.facebook.com/idphijuelas/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-idp-azul text-white rounded-full text-xs font-sans font-semibold hover:bg-idp-rojo transition-colors shadow-xs">Facebook</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>