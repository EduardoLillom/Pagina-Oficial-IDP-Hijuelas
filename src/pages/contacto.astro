---
// src/pages/contacto.astro
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Contacto">
  <section class="relative min-h-screen bg-idp-azul/5 py-24 pt-36 overflow-hidden">
    <!-- Fondo decorativo institucional difuminado -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-idp-purpura/10 rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-96 h-96 bg-idp-dorado/15 rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      
      <!-- Encabezado centrado con propósito UX -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <!-- Texto resaltado con Berkeley Oldstyle -->
        <span class="font-serif text-xs uppercase tracking-[0.3em] text-idp-rojo font-bold px-4 py-1.5 rounded-full bg-idp-rojo/10 border border-idp-rojo/20 inline-block mb-4">
          Conéctate con Nosotros
        </span>
        <!-- Titular con Aktiv Grotesk Ex -->
        <h1 class="font-heading text-4xl md:text-6xl font-extrabold text-idp-azul tracking-tight mb-6">
          Estamos aquí para escucharte y servirte
        </h1>
        <!-- Cuerpo de texto con Nunito Sans -->
        <p class="font-sans font-light text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          ¿Tienes una petición de oración, necesitas orientación o quieres visitarnos este fin de semana? Estos son nuestros canales oficiales.
        </p>
      </div>

      <!-- Grid principal de tarjetas (UX: Prioridad de información) -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 items-stretch mb-16">
        
        <!-- Tarjeta 1: Dirección y Horarios (Accionable) -->
        <div class="bg-white/90 backdrop-blur-md border border-idp-dorado/30 p-8 rounded-3xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-idp-dorado">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-idp-azul/10 text-idp-azul flex items-center justify-center mb-6 border border-idp-azul/15 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <!-- Texto resaltado con Berkeley Oldstyle -->
            <h3 class="font-serif text-xs font-bold uppercase tracking-wider text-idp-purpura mb-1">Lugar de Reunión</h3>
            <!-- Titular con Aktiv Grotesk Ex -->
            <p class="font-heading text-xl font-bold text-idp-azul">Sede Villa Los Naranjos</p>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light text-slate-500 text-sm mt-2">Hijuelas, Región de Valparaíso.</p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between">
            <!-- Texto resaltado con Berkeley Oldstyle -->
            <span class="px-3 py-1 bg-idp-dorado/20 text-idp-azul text-[11px] font-bold uppercase tracking-wide rounded-full border border-idp-dorado/40 font-serif">
              Ubicación temporal
            </span>
            <span class="font-sans text-xs font-medium text-slate-400">¡Te esperamos!</span>
          </div>
        </div>

        <!-- Tarjeta 2: Correo (Botón directo de acción) -->
        <div class="bg-white/90 backdrop-blur-md border border-idp-dorado/30 p-8 rounded-3xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-idp-dorado">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-idp-azul/10 text-idp-azul flex items-center justify-center mb-6 border border-idp-azul/15 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <!-- Texto resaltado con Berkeley Oldstyle -->
            <h3 class="font-serif text-xs font-bold uppercase tracking-wider text-idp-purpura mb-1">Escríbenos Directo</h3>
            <!-- Titular con Aktiv Grotesk Ex -->
            <p class="font-heading text-lg font-bold text-idp-azul">Correo Electrónico</p>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light text-slate-500 text-sm mt-2">Envíanos tus consultas o peticiones de oración.</p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a href="mailto:idphijuelas2026@gmail.com" class="font-sans font-semibold text-sm md:text-base text-idp-rojo hover:underline break-all block flex items-center gap-2">
              <span>✉️</span> idphijuelas2026@gmail.com
            </a>
          </div>
        </div>

        <!-- Tarjeta 3: Redes Sociales -->
        <div class="bg-white/90 backdrop-blur-md border border-idp-dorado/30 p-8 rounded-3xl shadow-xl shadow-idp-azul/5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-idp-dorado md:col-span-2 lg:col-span-1">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-idp-azul/10 text-idp-azul flex items-center justify-center mb-6 border border-idp-azul/15 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <!-- Texto resaltado con Berkeley Oldstyle -->
            <h3 class="font-serif text-xs font-bold uppercase tracking-wider text-idp-purpura mb-1">Comunidad Digital</h3>
            <!-- Titular con Aktiv Grotesk Ex -->
            <p class="font-heading text-lg font-bold text-idp-azul">Síguenos en Redes</p>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light mt-1 text-sm text-slate-500">Mantente al día con nuestras transmisiones y fotos.</p>
          </div>
          
          <div class="mt-6 flex flex-col gap-3">
            <!-- Instagram -->
            <a href="https://www.instagram.com/idphijuelas/" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-100 hover:border-idp-dorado/50 hover:bg-idp-azul/5 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-idp-azul/10 flex items-center justify-center text-idp-azul group-hover:bg-idp-rojo group-hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                </div>
                <!-- Cuerpo de texto con Nunito Sans -->
                <span class="font-sans font-semibold text-sm text-slate-800">Instagram</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-idp-rojo group-hover:translate-x-0.5 transition-all">&rarr;</span>
            </a>

            <!-- Facebook -->
            <a href="https://www.facebook.com/idphijuelas/" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-100 hover:border-idp-dorado/50 hover:bg-idp-azul/5 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-idp-azul/10 flex items-center justify-center text-idp-azul group-hover:bg-idp-rojo group-hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </div>
                <!-- Cuerpo de texto con Nunito Sans -->
                <span class="font-sans font-semibold text-sm text-slate-800">Instagram</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-idp-rojo group-hover:translate-x-0.5 transition-all">&rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Sección Extra de Apoyo UX: ¿Primera vez que nos visitas? -->
      <div class="bg-white border border-idp-dorado/40 rounded-4xl p-8 md:p-12 shadow-sm text-center max-w-4xl mx-auto">
        <!-- Texto resaltado con Berkeley Oldstyle -->
        <span class="font-serif text-xs uppercase tracking-widest text-idp-rojo font-bold block mb-2">Planifica tu visita</span>
        <!-- Titular con Aktiv Grotesk Ex -->
        <h3 class="font-heading text-2xl md:text-3xl font-bold text-idp-azul mb-4">¿Quieres asistir a uno de nuestros cultos?</h3>
        <!-- Cuerpo de texto con Nunito Sans -->
        <p class="font-sans font-light text-slate-600 max-w-xl mx-auto text-sm md:text-base mb-8 leading-relaxed">
          Nos encantaría recibirte en familia. No necesitas requisitos previos, solo un corazón dispuesto a alabar a Dios junto a nosotros.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/eventos" class="font-sans font-bold bg-idp-azul text-white px-6 py-3.5 rounded-full hover:bg-idp-azul/90 transition-all text-sm shadow-md">
            Ver próximos eventos
          </a>
          <a href="/nuestro-templo" class="font-sans font-semibold border border-idp-dorado text-idp-azul px-6 py-3.5 rounded-full hover:bg-idp-azul/5 transition-all text-sm">
            Conoce nuestro proyecto de templo
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>