---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getEventoById } from '../../../../lib/eventos';

const { id } = Astro.params;
const evento = id ? await getEventoById(id) : null;

if (!evento) {
  return Astro.redirect('/admin/eventos?error=not_found');
}
---

<AdminLayout title="Editar Evento">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Editar evento</h1>
      <p class="text-sm text-slate-500">Actualiza los datos del evento.</p>
    </div>

    <form action="/api/admin/eventos" method="POST" class="space-y-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
      <input type="hidden" name="_action" value="update" />
      <input type="hidden" name="id" value={evento.id} />

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Título del evento</label>
          <input type="text" name="title" required value={evento.title}
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Fecha</label>
            <input type="date" name="fecha" required value={evento.fecha}
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Hora</label>
            <input type="time" name="hora" required value={evento.hora}
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Descripción</label>
          <textarea name="descripcion" rows="4" required
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all">{evento.descripcion}</textarea>
        </div>
      </div>

      <div class="flex gap-3 pt-4">
        <a href="/admin/eventos"
          class="flex-1 text-center py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
          Cancelar
        </a>
        <button type="submit"
          class="flex-[2] bg-cyan-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 transition shadow-md shadow-cyan-200">
          Guardar cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>