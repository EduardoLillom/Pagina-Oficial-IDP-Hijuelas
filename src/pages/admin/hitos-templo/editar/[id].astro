---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getHitoById } from '../../../../lib/hitos';

const { id } = Astro.params;
const hito = await getHitoById(Astro.locals.supabase, id!);

if (!hito) {
  return Astro.redirect('/admin/hitos?error=not_found');
}
---
<AdminLayout title="Editar hito">
  <div class="mx-auto max-w-2xl">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Editar hito</h1>
      <p class="text-sm text-slate-500">Actualiza la información de este hito en la línea de tiempo.</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <form method="POST" action="/api/admin/hitos" enctype="multipart/form-data" class="space-y-5">
        <input type="hidden" name="accion" value="editar" />
        <input type="hidden" name="id" value={hito.id} />
        <input type="hidden" name="url_imagen_actual" value={hito.url_imagen ?? ''} />

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Título</label>
          <input
            type="text"
            name="titulo"
            value={hito.titulo}
            required
            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Fecha</label>
          <input
            type="date"
            name="fecha"
            value={hito.fecha}
            required
            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Descripción</label>
          <textarea
            name="descripcion"
            rows="3"
            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
          >{hito.descripcion}</textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Orden</label>
          <input
            type="number"
            name="orden"
            value={hito.orden}
            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Imagen</label>
          {hito.url_imagen && (
            <img src={hito.url_imagen} alt={hito.titulo} class="w-24 h-24 object-cover rounded-lg border border-slate-100 mb-3" />
          )}
          <input
            type="file"
            name="imagen"
            accept="image/*"
            class="w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200"
          />
          <p class="text-xs text-slate-400 mt-1.5">Deja vacío para mantener la imagen actual.</p>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button
            type="submit"
            class="bg-cyan-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 shadow-sm transition-all"
          >
            Guardar cambios
          </button>
          <a
            href="/admin/hitos-templo"
            class="text-sm font-medium text-slate-500 hover:text-slate-700 px-5 py-2.5"
          >
            Cancelar
            
          </a>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>