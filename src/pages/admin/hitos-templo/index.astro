---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getHitos } from '../../../lib/hitos';

const hitos = await getHitos(Astro.locals.supabase);
---

<AdminLayout title="Hitos">
  <div class="mx-auto max-w-4xl">
    <!-- Action Bar -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Hitos</h1>
        <p class="text-sm text-slate-500">Gestiona la línea de tiempo de la construcción del templo.</p>
      </div>
      <a href="/admin/hitos-templo/nuevo" 
         class="bg-cyan-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 shadow-sm transition-all flex items-center gap-2">
        <span>+</span> Nuevo hito
      </a>
    </div>

    <!-- Lista de Hitos -->
    <div class="grid gap-4">
      {hitos.length === 0 ? (
        <div class="p-12 text-center border-2 border-dashed border-slate-200 rounded-2xl text-slate-400">
          No hay hitos registrados.
        </div>
      ) : (
        hitos.map((hito) => (
          <div class="flex items-center gap-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-cyan-200 transition-all">
            <!-- Bloque de Fecha: Estilo calendario visual -->
            <div class="flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg w-16 h-16 shrink-0">
              <span class="text-xs font-bold text-cyan-600 uppercase tracking-wide">
                {new Date(hito.fecha).toLocaleDateString('es-ES', { month: 'short' })}
              </span>
              <span class="text-xl font-bold text-slate-700">
                {new Date(hito.fecha).getFullYear()}
              </span>
            </div>

            <!-- Miniatura de imagen (si existe) -->
            {hito.url_imagen && (
              <img src={hito.url_imagen} alt={hito.titulo} class="w-12 h-12 object-cover rounded-lg shrink-0 border border-slate-100" />
            )}

            <!-- Detalles -->
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <h4 class="font-semibold text-slate-900">{hito.titulo}</h4>
                <span class="text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded">
                  orden {hito.orden}
                </span>
              </div>
              <p class="text-sm text-slate-500 line-clamp-1">{hito.descripcion}</p>
            </div>

            <!-- Acciones -->
            <div class="flex items-center gap-2">
              <a href={`/admin/hitos-templo/editar/${hito.id}`} class="text-xs text-slate-500 hover:text-cyan-600 px-3 py-1.5">
                Editar
              </a>
              <form method="POST" action="/api/admin/hitos" onsubmit="return confirm('¿Estás seguro de eliminar este hito?')">
                <input type="hidden" name="accion" value="eliminar" />
                <input type="hidden" name="id" value={hito.id} />
                <button type="submit" class="text-xs font-medium text-red-500 hover:text-red-700 px-3 py-1.5">
                  Eliminar
                </button>
              </form>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</AdminLayout>