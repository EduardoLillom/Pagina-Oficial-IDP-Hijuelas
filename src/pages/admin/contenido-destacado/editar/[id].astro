---
// src/pages/admin/tarjetas-hero/editar/[id].astro
import Layout from '../../../../layouts/AdminLayout.astro';
import { getTarjetaById } from '../../../../lib/tarjetasHero';

if (!Astro.locals.user) return Astro.redirect('/admin/login');

const { id } = Astro.params;
const tarjeta = await getTarjetaById(Astro.locals.supabase, id as string);

if (!tarjeta) return Astro.redirect('/admin/tarjetas-hero?error=not_found');

// Para datetime-local hay que cortar a "YYYY-MM-DDTHH:mm"
const toLocalInput = (iso: string | null) => (iso ? iso.slice(0, 16) : '');
const botones = tarjeta.botones ?? [];
---

<Layout title="Editar tarjeta">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Editar tarjeta</h1>

  <form method="POST" action="/api/admin/tarjetas-hero" class="bg-white rounded-xl shadow p-6 space-y-5 max-w-2xl">
    <input type="hidden" name="action" value="editar" />
    <input type="hidden" name="id" value={tarjeta.id} />

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">Tipo</label>
      <select name="tipo" required class="w-full border border-slate-300 rounded-lg px-3 py-2">
        <option value="aviso" selected={tarjeta.tipo === 'aviso'}>Aviso</option>
        <option value="noticia" selected={tarjeta.tipo === 'noticia'}>Noticia</option>
        <option value="evento" selected={tarjeta.tipo === 'evento'}>Evento</option>
        <option value="cita" selected={tarjeta.tipo === 'cita'}>Cita bíblica</option>
      </select>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">Título</label>
      <input type="text" name="titulo" required value={tarjeta.titulo} class="w-full border border-slate-300 rounded-lg px-3 py-2" />
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">
        Contenido <span class="font-normal text-slate-400">(markdown: **negrita**, [texto](url). Si el tipo es "Cita", este es el texto de la cita)</span>
      </label>
      <textarea name="contenido" rows="4" required class="w-full border border-slate-300 rounded-lg px-3 py-2">{tarjeta.contenido}</textarea>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">
        Referencia de la cita <span class="font-normal text-slate-400">(solo aplica si el tipo es "Cita", ej: Juan 3:16)</span>
      </label>
      <input type="text" name="cita_referencia" value={tarjeta.cita_referencia ?? ''} class="w-full border border-slate-300 rounded-lg px-3 py-2" />
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">
        Fecha del evento <span class="font-normal text-slate-400">(solo aplica si el tipo es "Evento")</span>
      </label>
      <input
        type="datetime-local"
        name="fecha_evento"
        value={toLocalInput(tarjeta.fecha_evento)}
        class="w-full border border-slate-300 rounded-lg px-3 py-2"
      />
    </div>

    <fieldset class="border border-slate-200 rounded-lg p-4">
      <legend class="text-sm font-semibold text-slate-700 px-1">Botones (opcional, hasta 3)</legend>
      <div class="space-y-3">
        {[0, 1, 2].map((i) => (
          <div class="grid grid-cols-2 gap-3">
            <input
              type="text"
              name={`boton_texto_${i + 1}`}
              placeholder={`Texto botón ${i + 1}`}
              value={botones[i]?.texto ?? ''}
              class="border border-slate-300 rounded-lg px-3 py-2"
            />
            <input
              type="url"
              name={`boton_url_${i + 1}`}
              placeholder={`URL botón ${i + 1}`}
              value={botones[i]?.url ?? ''}
              class="border border-slate-300 rounded-lg px-3 py-2"
            />
          </div>
        ))}
      </div>
    </fieldset>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Orden</label>
        <input type="number" name="orden" value={tarjeta.orden} class="w-full border border-slate-300 rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">
          Fecha de expiración <span class="font-normal text-slate-400">(opcional)</span>
        </label>
        <input
          type="datetime-local"
          name="fecha_expiracion"
          value={toLocalInput(tarjeta.fecha_expiracion)}
          class="w-full border border-slate-300 rounded-lg px-3 py-2"
        />
      </div>
    </div>

    <label class="flex items-center gap-2">
      <input type="checkbox" name="is_active" checked={tarjeta.is_active} class="rounded border-slate-300" />
      <span class="text-sm font-semibold text-slate-700">Activa (visible en el sitio)</span>
    </label>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="bg-cyan-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-cyan-700 transition">
        Guardar cambios
      </button>
      <a href="/admin/contenido-destacado" class="px-5 py-2 rounded-lg font-semibold text-slate-600 hover:bg-slate-100 transition">
        Cancelar
      </a>
    </div>
  </form>
</Layout>