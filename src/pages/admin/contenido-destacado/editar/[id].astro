---
// src/pages/admin/contenido-destacado/editar/[id].astro
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getPostById } from '../../../../lib/posts';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/contenido-destacado?error=not_found');
}

const { supabase } = Astro.locals;
let post;

try {
  post = await getPostById(supabase, id);
} catch (err) {
  console.error('Error al cargar post', id, err);
  return Astro.redirect('/admin/contenido-destacado?error=not_found');
}

if (!post) {
  return Astro.redirect('/admin/contenido-destacado?error=not_found');
}
---

<AdminLayout title="Editar Publicación">
  <div class="mx-auto max-w-4xl space-y-8">

    <!-- Cabecera -->
    <div class="flex items-center gap-4">
      <a href="/admin/contenido-destacado" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-600 transition hover:border-cyan-600 hover:text-cyan-600 shadow-sm">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 text-cyan-700 text-xs font-semibold mb-1 border border-cyan-100">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-600 animate-pulse"></span> Editor
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Editar publicación</h1>
        <p class="text-sm text-slate-500">Modifica el contenido para el carrusel y las secciones principales.</p>
      </div>
    </div>

    <form action="/api/admin/post" method="POST" class="space-y-6">
      <input type="hidden" name="_action" value="update" />
      <input type="hidden" name="id" value={post.id} />

      <!-- Bloque Principal de Configuración -->
      <div class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-sm space-y-6">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Tipo de contenido</label>
            <select id="type-selector" name="type" class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20">
              <option value="noticia" selected={post.type === 'noticia'}>Noticia</option>
              <option value="evento" selected={post.type === 'evento'}>Evento</option>
              <option value="aviso" selected={post.type === 'aviso'}>Aviso</option>
              <option value="cita" selected={post.type === 'cita'}>Cita / Frase</option>
            </select>
          </div>

          <div class="flex items-end">
            <label class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 w-full cursor-pointer">
              <input
                type="checkbox"
                name="is_active"
                checked={post.is_active}
                class="h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500"
              />
              <span class="text-sm font-semibold text-slate-700">Publicación activa</span>
            </label>
          </div>

          <div class="sm:col-span-2">
            <label id="label-title" class="block text-sm font-semibold text-slate-700 mb-2">Título *</label>
            <input id="input-title" name="title" type="text" required value={post.title} placeholder="Título principal..." class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20" />
          </div>
        </div>
      </div>

      <!-- Resumen -->
      <div id="section-summary" class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-sm">
        <label id="label-summary" class="block text-sm font-semibold text-slate-700 mb-2">Resumen</label>
        <textarea id="input-summary" name="summary" rows="3" placeholder="Descripción breve..." class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20">{post.summary}</textarea>
      </div>

      <!-- Contenido Detallado -->
      <div id="group-content" class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-sm">
        <label class="block text-sm font-semibold text-slate-700 mb-2">Contenido Detallado</label>
        <textarea name="content" rows="5" placeholder="Detalles extendidos..." class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20">{post.content}</textarea>
      </div>

      <!-- Botones de Acción -->
      <div class="flex items-center justify-end gap-4 pt-2">
        <a href="/admin/contenido-destacado" class="text-sm font-semibold text-slate-600 hover:text-slate-900 px-4 py-2 transition">Cancelar</a>
        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-cyan-600 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-cyan-600/20 transition hover:bg-cyan-500 active:scale-[0.98]">
          Guardar cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  function setupForm() {
    const selector = document.getElementById('type-selector') as HTMLSelectElement;
    const groupContent = document.getElementById('group-content');
    const sectionSummary = document.getElementById('section-summary');
    const labelTitle = document.getElementById('label-title');
    const labelSummary = document.getElementById('label-summary');
    const inputTitle = document.getElementById('input-title') as HTMLInputElement;

    function applyTypeUI(type: string) {
      groupContent?.classList.remove('hidden');
      sectionSummary?.classList.remove('hidden');

      if (type === 'cita') {
        if (labelTitle) labelTitle.innerText = "Cita Completa (con autor) *";
        if (inputTitle) inputTitle.placeholder = "Ej: \"La fe es dar el primer paso...\" — Autor";
        sectionSummary?.classList.add('hidden');
        groupContent?.classList.add('hidden');
      } else if (type === 'aviso') {
        if (labelTitle) labelTitle.innerText = "Título del Aviso *";
        if (labelSummary) labelSummary.innerText = "Mensaje breve";
        if (inputTitle) inputTitle.placeholder = "Título principal...";
        groupContent?.classList.add('hidden');
      } else if (type === 'evento') {
        if (labelTitle) labelTitle.innerText = "Nombre del Evento *";
        if (labelSummary) labelSummary.innerText = "Breve descripción";
        if (inputTitle) inputTitle.placeholder = "Título principal...";
      } else {
        if (labelTitle) labelTitle.innerText = "Título de la Noticia *";
        if (labelSummary) labelSummary.innerText = "Resumen / Extracto";
        if (inputTitle) inputTitle.placeholder = "Título principal...";
      }
    }

    selector?.addEventListener('change', () => applyTypeUI(selector.value));

    // Aplica el estado correcto al cargar, según el tipo ya guardado
    if (selector) applyTypeUI(selector.value);
  }
  setupForm();
</script>