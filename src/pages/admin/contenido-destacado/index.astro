---
// src/pages/admin/tarjetas-hero/index.astro
import Layout from '../../../layouts/AdminLayout.astro';
import { getTarjetasAdmin } from '../../../lib/tarjetasHero';

if (!Astro.locals.user) return Astro.redirect('/admin/login');

const tarjetas = await getTarjetasAdmin(Astro.locals.supabase);
const error = Astro.url.searchParams.get('error');

const ETIQUETAS: Record<string, string> = {
  aviso: 'Aviso',
  noticia: 'Noticia',
  evento: 'Evento',
  cita: 'Cita',
};
---

<Layout title="Tarjetas del Hero">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Tarjetas del Hero</h1>
    <a
      href="/admin/tarjetas-hero/nuevo"
      class="bg-cyan-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-cyan-700 transition"
    >
      + Nueva tarjeta
    </a>
  </div>

  {error && (
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
      Ocurrió un error al guardar. Intentá de nuevo.
    </div>
  )}

  <div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-left">
      <thead class="bg-slate-50 text-slate-500 text-sm uppercase tracking-wide">
        <tr>
          <th class="px-4 py-3">Orden</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Título</th>
          <th class="px-4 py-3">Activa</th>
          <th class="px-4 py-3">Expira</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {tarjetas.map((t) => (
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 text-slate-500">{t.orden}</td>
            <td class="px-4 py-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-700 bg-cyan-50 px-2 py-1 rounded-full">
                {ETIQUETAS[t.tipo]}
              </span>
            </td>
            <td class="px-4 py-3 font-medium text-slate-800">{t.titulo}</td>
            <td class="px-4 py-3">
              <form method="POST" action="/api/admin/tarjetas-hero">
                <input type="hidden" name="action" value="toggle" />
                <input type="hidden" name="id" value={t.id} />
                <input type="hidden" name="nuevo_estado" value={(!t.is_active).toString()} />
                <button
                  type="submit"
                  class={`text-xs font-semibold px-3 py-1 rounded-full transition ${
                    t.is_active
                      ? 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200'
                      : 'bg-slate-100 text-slate-500 hover:bg-slate-200'
                  }`}
                >
                  {t.is_active ? 'Activa' : 'Inactiva'}
                </button>
              </form>
            </td>
            <td class="px-4 py-3 text-slate-500 text-sm">
              {t.fecha_expiracion ? new Date(t.fecha_expiracion).toLocaleDateString('es-CL') : '—'}
            </td>
            <td class="px-4 py-3 text-right space-x-3">
              <a href={`/admin/contenido-destacado/editar/${t.id}`} class="text-cyan-600 font-semibold hover:underline">
                Editar
              </a>
              <form
                method="POST"
                action="/api/admin/tarjetas-hero"
                class="inline"
                onsubmit="return confirm('¿Eliminar esta tarjeta? Esta acción no se puede deshacer.')"
              >
                <input type="hidden" name="action" value="eliminar" />
                <input type="hidden" name="id" value={t.id} />
                <button type="submit" class="text-red-600 font-semibold hover:underline">
                  Eliminar
                </button>
              </form>
            </td>
          </tr>
        ))}
        {tarjetas.length === 0 && (
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-slate-400">
              Todavía no hay tarjetas cargadas.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</Layout>