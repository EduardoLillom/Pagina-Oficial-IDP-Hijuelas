---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAlbumes } from '../../../lib/galeria';

const albumes = await getAlbumes();
---

<AdminLayout title="Galería">
  <div class="mx-auto max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Galería</h1>
        <p class="text-sm text-slate-500">Gestiona los álbumes de fotos del sitio.</p>
      </div>
      <a href="/admin/galeria/nuevo"
         class="bg-cyan-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 shadow-sm transition-all flex items-center gap-2">
        <span>+</span> Nuevo álbum
      </a>
    </div>

    <div class="grid gap-4">
      {albumes.length === 0 ? (
        <div class="p-12 text-center border-2 border-dashed border-slate-200 rounded-2xl text-slate-400">
          No hay álbumes creados.
        </div>
      ) : (
        albumes.map((album) => (
          <div class="flex items-center gap-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-cyan-200 transition-all">
            <img src={album.url_portada} alt={album.titulo} class="w-16 h-16 object-cover rounded-lg shrink-0" />

            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <h4 class="font-semibold text-slate-900">{album.titulo}</h4>
                <span class="text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded">
                  orden: {album.orden}
                </span>
              </div>
              <p class="text-sm text-slate-500 line-clamp-1">{album.descripcion}</p>
              <a href={album.url_album} target="_blank" class="text-xs text-cyan-600 hover:underline">
                Ver álbum completo →
              </a>
            </div>

            <div class="flex items-center gap-2">
              <a href={`/admin/galeria/editar/${album.id}`} class="text-xs text-slate-500 hover:text-cyan-600 px-3 py-1.5">
                Editar
              </a>
              <form method="POST" action="/api/admin/galeria" onsubmit="return confirm('¿Estás seguro de eliminar este álbum? También se borrará la imagen de portada.')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={album.id} />
                <button type="submit" class="text-xs font-medium text-red-500 hover:text-red-700 px-3 py-1.5">
                  Eliminar
                </button>
              </form>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</AdminLayout>