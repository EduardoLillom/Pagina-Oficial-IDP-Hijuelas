---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getAlbumById } from '../../../../lib/galeria';

const { id } = Astro.params;
const album = id ? await getAlbumById(id) : null;

if (!album) {
  return Astro.redirect('/admin/galeria?error=not_found');
}
---

<AdminLayout title="Editar Álbum">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Editar álbum</h1>
      <p class="text-sm text-slate-500">Actualiza los datos del álbum.</p>
    </div>

    <form action="/api/admin/galeria" method="POST" enctype="multipart/form-data"
      class="space-y-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
      <input type="hidden" name="_action" value="update" />
      <input type="hidden" name="id" value={album.id} />
      <input type="hidden" name="url_portada_actual" value={album.url_portada} />

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Título del álbum</label>
          <input type="text" name="titulo" required value={album.titulo}
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Descripción</label>
          <textarea name="descripcion" rows="3"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all">{album.descripcion}</textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Link del álbum (Google Photos)</label>
          <input type="url" name="url_album" required value={album.url_album}
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Portada actual</label>
          <img src={album.url_portada} alt={album.titulo} class="w-32 h-32 object-cover rounded-xl border border-slate-200 mb-3" />
          <label class="block text-sm font-semibold text-slate-700 mb-1">Reemplazar portada (opcional)</label>
          <input type="file" name="portada" accept="image/*"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-cyan-50 file:text-cyan-700 file:text-sm file:font-semibold" />
          <p class="text-xs text-slate-400 mt-1">Deja vacío para mantener la imagen actual.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Orden</label>
          <input type="number" name="orden" value={album.orden}
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
        </div>
      </div>

      <div class="flex gap-3 pt-4">
        <a href="/admin/galeria"
          class="flex-1 text-center py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
          Cancelar
        </a>
        <button type="submit"
          class="flex-2 bg-cyan-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 transition shadow-md shadow-cyan-200">
          Guardar cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>