---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AlbumCard from '../../../components/AlbumCard.astro';
---

<AdminLayout title="Nuevo Álbum">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Crear nuevo álbum</h1>
      <p class="text-sm text-slate-500">Sube la portada y enlaza el álbum completo de Google Photos.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 items-start">
      <form id="form-nuevo-album" action="/api/admin/galeria" method="POST" enctype="multipart/form-data"
        class="space-y-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
        <input type="hidden" name="_action" value="create" />

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Título del álbum</label>
            <input type="text" name="titulo" required placeholder="Ej: Campamento de jóvenes 2026"
              data-preview="titulo"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Descripción</label>
            <textarea name="descripcion" rows="3" placeholder="Breve descripción del álbum..."
              data-preview="descripcion"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Link del álbum (Google Photos)</label>
            <input type="url" name="url_album" required placeholder="https://photos.app.goo.gl/..."
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Imagen de portada</label>
            <input type="file" name="portada" accept="image/*" required
              data-preview="portada"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-cyan-50 file:text-cyan-700 file:text-sm file:font-semibold" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Orden</label>
            <input type="number" name="orden" value="0"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
            <p class="text-xs text-slate-400 mt-1">Menor número aparece primero.</p>
          </div>
        </div>

        <div class="flex gap-3 pt-4">
          <a href="/admin/galeria"
            class="flex-1 text-center py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
            Cancelar
          </a>
          <button type="submit"
            class="flex-2 bg-cyan-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-cyan-700 transition shadow-md shadow-cyan-200">
            Guardar Álbum
          </button>
        </div>
      </form>

      <!-- Previsualización: mismo componente que se usa en /galeria -->
      <div class="lg:sticky lg:top-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
          Así se verá en la galería
        </p>
        <div id="album-preview">
          <AlbumCard
            titulo=""
            descripcion={null}
            urlPortada={null}
            interactive={false}
          />
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('form-nuevo-album') as HTMLFormElement;
  const preview = document.getElementById('album-preview') as HTMLElement;

  const tituloEl = preview.querySelector('[data-card-titulo]') as HTMLElement;
  const descEl = preview.querySelector('[data-card-descripcion]') as HTMLElement;
  const imgEl = preview.querySelector('[data-card-img]') as HTMLImageElement | null;
  const placeholderEl = preview.querySelector('[data-card-placeholder]') as HTMLElement | null;

  form.querySelector('[data-preview="titulo"]')?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    tituloEl.textContent = value || 'Título del álbum';
  });

  form.querySelector('[data-preview="descripcion"]')?.addEventListener('input', (e) => {
    const value = (e.target as HTMLTextAreaElement).value;
    descEl.textContent = value;
    descEl.classList.toggle('hidden', !value);
  });

  form.querySelector('[data-preview="portada"]')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const url = URL.createObjectURL(file);

    if (imgEl) {
      imgEl.src = url;
    } else if (placeholderEl) {
      // primera vez: reemplazar el placeholder por un <img>
      const img = document.createElement('img');
      img.setAttribute('data-card-img', '');
      img.className = 'h-full w-full object-cover transition-transform duration-500';
      img.src = url;
      placeholderEl.replaceWith(img);
    }
  });
</script>