---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
const status = Astro.url.searchParams.get('status');
const alert = status === 'post-created'
  ? 'Publicación creada correctamente. Aquí puedes continuar agregando más contenido.'
  : status === 'post-failed'
  ? 'Error: el título del post es obligatorio.'
  : null;
---

<AdminLayout title="Panel Administrativo">
  <div class="space-y-8">
    
    <!-- Cabecera de bienvenida -->
    <div class="flex flex-col gap-4 rounded-3xl border border-slate-200/80 bg-white p-8 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 text-cyan-700 text-xs font-semibold mb-3 border border-cyan-100">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-600 animate-pulse"></span> Sistema Activo
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Gestiona tus publicaciones</h1>
        <p class="mt-1 text-sm text-slate-500">Agrega nuevo contenido y mantén tu sitio web actualizado de forma rápida.</p>
      </div>

      <a href="/admin/change-password" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-cyan-300 hover:text-cyan-700 hover:bg-white shadow-sm">
        Cambiar contraseña
      </a>
    </div>

    <!-- Alertas de estado -->
    {alert && (
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-6 py-4 text-sm font-medium text-emerald-900 shadow-sm">
        {alert}
      </div>
    )}

    <!-- Formulario principal para nuevo post -->
    <section class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-sm">
      <div class="mb-8 pb-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Nuevo contenido para la web</h2>
          <p class="text-sm text-slate-500 mt-0.5">Completa los campos para publicar inmediatamente en la plataforma.</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-cyan-50 px-3.5 py-1 text-xs font-semibold text-cyan-700 border border-cyan-100">Editor Activo</span>
      </div>

      <form action="/api/admin/post" method="POST" class="space-y-6">
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold text-slate-700 mb-2 block">Título</span>
            <input name="title" type="text" placeholder="Ej: Anuncio importante" class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20" required />
          </label>

          <label class="block">
            <span class="text-sm font-semibold text-slate-700 mb-2 block">Categoría</span>
            <select name="category" class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20">
              <option>General</option>
              <option>Noticias</option>
              <option>Eventos</option>
              <option>Testimonios</option>
            </select>
          </label>
        </div>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700 mb-2 block">Extracto</span>
          <textarea name="excerpt" rows="2" placeholder="Resumen breve de la publicación" class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20"></textarea>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700 mb-2 block">Contenido</span>
          <textarea name="content" rows="6" placeholder="Escribe aquí el texto completo del post" class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:bg-white focus:ring-2 focus:ring-cyan-500/20"></textarea>
        </label>

        <div class="flex flex-col gap-4 pt-6 border-t border-slate-100 sm:flex-row sm:items-center sm:justify-between">
          <label class="inline-flex items-center gap-3 cursor-pointer text-sm text-slate-600 font-medium">
            <input type="checkbox" name="publish" class="h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" />
            Publicar inmediatamente
          </label>

          <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-cyan-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-600/20 transition hover:bg-cyan-500 active:scale-[0.98]">
            Guardar post
          </button>
        </div>
      </form>
    </section>

  </div>
</AdminLayout>