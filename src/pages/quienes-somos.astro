---
// src/pages/nosotros.astro
import { Image } from 'astro:assets';
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";

import logoHijuelas from "../assets/logos/logo-hijuelas.webp"

export const prerender = true;

const tabs = [
  { id: "quienes", label: "Quiénes somos" },
  { id: "vision", label: "Nuestra visión" },
  { id: "mision", label: "Nuestra misión" },
];

const misionPilares = [
  {
    title: "Que exalta a Cristo",
    text: "Que Jesucristo se vea reflejado en todo lo que hagamos. Él es la Cabeza del Cuerpo y por lo tanto debe tener la preeminencia en todo.",
  },
  {
    title: "Gente que procura la santidad",
    text: "Nacimos del arrollador avivamiento de las reuniones campestres de santidad. El llamado a la santidad está profundamente arraigado en nuestras raíces.",
  },
  {
    title: "Lleno del Espíritu",
    text: "La promesa profética de que 'en los últimos días derramará Su Espíritu' sigue siendo una parte central de nuestro ADN mundial.",
  },
  {
    title: "Abierto a todas las naciones",
    text: "Nos aferramos al ideal de que la iglesia de Dios estaría compuesta por toda 'tribu, lengua, pueblo y nación'. Celebramos la diversidad.",
  },
  {
    title: "Hacedor de discípulos",
    text: "Por más de un siglo de ministerio, esta red familiar se ha comprometido con el mandato bíblico de la Gran Comisión.",
  },
  {
    title: "Establecedor de iglesias",
    text: "Las iglesias sanas que plantan nuevas iglesias contribuyen en gran medida a la difusión del evangelio en todo el mundo.",
  },
  {
    title: "Unión cristiana",
    text: "Nos proponemos cooperar con todos los que exaltan el nombre de Cristo y Su gran evangelio en un espíritu de unidad.",
  },
];
---
<BaseLayout 
  pageTitle="Quiénes somos"
  description="Conoce la historia, visión y misión de la Iglesia de Dios de la Profecía en Hijuelas. Una comunidad de fe dedicada al servicio, la adoración y el amor a Cristo."
>
  <section class="bg-idp-azul/5 pt-24 pb-12 md:pt-32 py-12 md:py-20 transition-all duration-300">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-10 md:space-y-16">
      
      <!-- Bloque Principal: Historia -->
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] items-center">
        <div class="space-y-6 order-2 lg:order-1">
          <SectionTitle title="Quiénes somos" />
          <p class="font-sans font-light text-slate-700 text-justify text-base md:text-lg leading-relaxed">
            La Iglesia de Dios de la Profecía en Hijuelas nació con el propósito de compartir el amor de Cristo y 
            servir a la comunidad local. Sus inicios se remontan al año 2016, cuando comenzó como una misión dedicada 
            a la evangelización mediante campañas al aire libre, actividades comunitarias y un firme compromiso con la 
            enseñanza de la Palabra de Dios. Gracias al crecimiento de la congregación, al trabajo constante de sus miembros 
            y a la fidelidad de Dios, la misión fue establecida oficialmente como iglesia, consolidando una comunidad de fe 
            comprometida con la adoración, el servicio y el desarrollo espiritual de las personas. Bajo el liderazgo pastoral 
            de Fernando Toro, la iglesia se ha caracterizado por su dedicación a la comunidad, el fortalecimiento de la hermandad
            cristiana y el acompañamiento espiritual de familias y personas de todas las edades. Hoy continuamos trabajando con 
            la misma visión: llevar esperanza, compartir el mensaje de Jesucristo y ser un lugar donde cada persona pueda 
            encontrar fe, amor y propósito.
          </p>
        </div>

        <div class="overflow-hidden order-1 lg:order-2 h-48 sm:h-64 lg:h-full min-h-62.5 lg:min-h-100 rounded-3xl shadow-xl border-2 border-idp-dorado/30">
          <Image
            src={logoHijuelas}
            alt="Logo Oficial Iglesia Dios de la Profecia Hijuelas"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Navegación por Pestañas (Tabs) -->
      <div id="contentRef" class="rounded-3xl bg-white border border-idp-dorado/40 p-6 md:p-8 shadow-md scroll-mt-6">
        <div class="flex flex-col items-center gap-3 text-center mb-8">
          <!-- Texto resaltado con Berkeley Oldstyle -->
          <p class="font-serif text-xs uppercase tracking-[0.28em] text-idp-rojo font-bold">Explora</p>
          <!-- Titular con Aktiv Grotesk Ex -->
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-idp-azul">Nuestra historia, visión y misión</h2>
          <!-- Cuerpo de texto con Nunito Sans -->
          <p class="font-sans font-light max-w-2xl text-slate-600 text-sm md:text-base">
            Descubre nuestra identidad y propósito en Hijuelas.
          </p>
        </div>

        <div class="flex justify-start md:justify-center overflow-x-auto no-scrollbar -mx-6 px-6 md:mx-0 md:px-0">
          <div role="tablist" aria-label="Secciones sobre nosotros" class="inline-flex rounded-full bg-idp-azul/5 p-1 mb-2 whitespace-nowrap min-w-full md:min-w-0">
            {tabs.map((tabItem, index) => (
              <button
                type="button"
                id={`tab-${tabItem.id}-btn`}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`tab-${tabItem.id}`}
                data-tab-target={tabItem.id}
                class={`tab-btn flex-1 md:flex-initial text-center px-5 py-2.5 rounded-full text-xs md:text-sm font-sans font-semibold transition-all duration-200 select-none cursor-pointer ${
                  index === 0 
                    ? 'bg-idp-azul text-white shadow-md' 
                    : 'text-slate-600 hover:text-idp-azul hover:bg-idp-azul/10'
                }`}
              >
                {tabItem.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Contenido Dinámico de las Pestañas -->
      <div class="transition-all duration-300">
        
        <!-- Tab: Quiénes somos -->
        <div id="tab-quienes" role="tabpanel" aria-labelledby="tab-quienes-btn" aria-hidden="false" class="tab-content space-y-6 md:space-y-8">
          <div class="rounded-3xl bg-white p-6 md:p-10 shadow-md border border-idp-purpura/20">
            <!-- Titular con Aktiv Grotesk Ex -->
            <h3 class="font-heading text-xl md:text-2xl font-bold text-idp-azul mb-4">Quién es la Iglesia de Dios de la Profecía</h3>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light text-slate-700 leading-relaxed text-sm md:text-base">
              La Iglesia de Dios de la Profecía es un vibrante movimiento cristiano fundamentado en las Escrituras, firme en la fe y decidido en su pasión por las personas. Somos un cuerpo mundial de creyentes, unidos en la adoración, que trabajan hombro a hombro para compartir el amor de Dios y un mensaje de esperanza para los quebrantados de corazón.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div class="rounded-2xl bg-linear-to-br from-idp-azul/5 to-white border border-idp-azul/15 p-5 md:p-6 shadow-xs">
              <!-- Texto resaltado con Berkeley Oldstyle -->
              <p class="font-serif text-xs uppercase tracking-wider text-idp-rojo font-bold mb-2">Impacto Global</p>
              <!-- Titular con Aktiv Grotesk Ex -->
              <p class="font-heading text-2xl md:text-3xl font-black text-idp-azul mb-1">300</p>
              <!-- Cuerpo de texto con Nunito Sans -->
              <p class="font-sans text-slate-600 text-xs md:text-sm">personas reciben salvación cada 24 horas</p>
            </div>
            <div class="rounded-2xl bg-linear-to-br from-idp-azul/5 to-white border border-idp-azul/15 p-5 md:p-6 shadow-xs">
              <!-- Texto resaltado con Berkeley Oldstyle -->
              <p class="font-serif text-xs uppercase tracking-wider text-idp-rojo font-bold mb-2">Bautismos</p>
              <!-- Titular con Aktiv Grotesk Ex -->
              <p class="font-heading text-2xl md:text-3xl font-black text-idp-azul mb-1">~100</p>
              <!-- Cuerpo de texto con Nunito Sans -->
              <p class="font-sans text-slate-600 text-xs md:text-sm">personas bautizadas en agua cada día</p>
            </div>
            <div class="rounded-2xl bg-linear-to-br from-idp-azul/5 to-white border border-idp-azul/15 p-5 md:p-6 shadow-xs sm:col-span-2 lg:col-span-1">
              <!-- Texto resaltado con Berkeley Oldstyle -->
              <p class="font-serif text-xs uppercase tracking-wider text-idp-rojo font-bold mb-2">Predicadores</p>
              <!-- Titular con Aktiv Grotesk Ex -->
              <p class="font-heading text-2xl md:text-3xl font-black text-idp-azul mb-1">14,000+</p>
              <!-- Cuerpo de texto con Nunito Sans -->
              <p class="font-sans text-slate-600 text-xs md:text-sm">lugares de predicación activa del evangelio</p>
            </div>
          </div>
        </div>

        <!-- Tab: Visión -->
<div id="tab-vision" role="tabpanel" aria-labelledby="tab-vision-btn" aria-hidden="true" class="tab-content hidden space-y-6 md:space-y-8">
  <div class="relative overflow-hidden rounded-3xl bg-white p-6 md:p-10 shadow-md border border-idp-purpura/20">
    <!-- Acento decorativo -->
    <div class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-idp-dorado/10 blur-2xl"></div>

    <div class="relative grid gap-8 lg:grid-cols-[auto,1fr] items-center">
      <!-- Icono / marca visual -->
      <div class="flex justify-center lg:justify-start">
        <div class="flex h-20 w-20 md:h-24 md:w-24 items-center justify-center rounded-2xl bg-idp-azul/10 text-idp-azul">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 md:h-12 md:w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
      </div>

      <div class="space-y-3 text-center lg:text-left">
        <span class="inline-block font-sans text-xs md:text-sm font-black uppercase tracking-wider text-idp-dorado">
          Hacia dónde vamos
        </span>
        <h3 class="font-heading text-2xl md:text-3xl font-bold text-idp-azul">
          Nuestra visión
        </h3>
        <p class="font-sans font-light text-slate-700 text-sm md:text-base leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Ser una iglesia vibrante y espiritualmente sana, guiada por el poder del Espíritu Santo, dedicada a reconciliar a las almas con Cristo y profundamente comprometida con el cumplimiento fiel de la Gran Comisión.
        </p>
      </div>
    </div>
  </div>
</div>

        <!-- Tab: Misión -->
        <div id="tab-mision" role="tabpanel" aria-labelledby="tab-mision-btn" aria-hidden="true" class="tab-content hidden space-y-6">
          <div class="rounded-3xl bg-white p-6 md:p-10 shadow-md border border-idp-purpura/20">
            <!-- Titular con Aktiv Grotesk Ex -->
            <h3 class="font-heading text-xl md:text-2xl font-bold text-idp-azul mb-3">Nuestra misión</h3>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light text-slate-700 text-sm md:text-base leading-relaxed">
              La Iglesia de Dios de la Profecía será un movimiento que exalte a Cristo, procure la santidad, esté lleno del Espíritu, esté abierto a todas las naciones, sea hacedor de discípulos, sea establecedor de iglesias, y sienta gran pasión por la unión cristiana.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {misionPilares.map((item) => (
              <div class="rounded-2xl bg-white border border-idp-purpura/15 p-5 shadow-xs transition hover:border-idp-dorado">
                <!-- Titular con Aktiv Grotesk Ex -->
                <p class="font-heading text-base font-bold text-idp-azul mb-2 flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-idp-rojo"></span>{item.title}
                </p>
                <!-- Cuerpo de texto con Nunito Sans -->
                <p class="font-sans font-light text-slate-600 text-xs md:text-sm">{item.text}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initTabs() {
    const buttons = document.querySelectorAll('[data-tab-target]');
    const contents = document.querySelectorAll('.tab-content');
    const contentRef = document.getElementById('contentRef');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');

        buttons.forEach(b => {
          b.classList.remove('bg-idp-azul', 'text-white', 'shadow-md');
          b.classList.add('text-slate-600', 'hover:text-idp-azul', 'hover:bg-idp-azul/10');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('bg-idp-azul', 'text-white', 'shadow-md');
        btn.classList.remove('text-slate-600', 'hover:text-idp-azul', 'hover:bg-idp-azul/10');
        btn.setAttribute('aria-selected', 'true');

        contents.forEach(content => {
          const isActive = content.id === `tab-${targetId}`;
          content.classList.toggle('hidden', !isActive);
          content.setAttribute('aria-hidden', String(!isActive));
        });

        if (contentRef) {
          contentRef.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  initTabs();
  document.addEventListener('astro:after-swap', initTabs);
</script>