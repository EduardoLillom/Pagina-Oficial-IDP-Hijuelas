---
// src/pages/index.astro
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import Carousel from '../components/Carousel.astro';
import { services } from '../consts/services.js';
import { getActivePosts, type Slide } from '../lib/posts';

import JovenImage from '../assets/gallery/joven.webp'
import bibliaImage from '../assets/gallery/biblia.webp'
import alabanzaBautizoImage from '../assets/gallery/alabanzaBautizo.webp'

import bautizoImage from '../assets/gallery/bautizo.webp'
import iconoOracion from '../assets/icons/icono-oracion.webp'
import iconoAdoracion from '../assets/icons/icono-adoracion.webp'
import iconoServicio from '../assets/icons/icono-servicio.webp'

import Oracion from "../components/icons/Oracion.astro";
// import Adoracion from "../components/icons/Adoracion.astro";
import Servicio from "../components/icons/Servicio.astro";

const images = [
  { src: JovenImage, pos: 'object-right', alt: 'Joven en adoración' },
  { src: bibliaImage, pos: 'object-center', alt: 'Biblia abierta' },
  { src: alabanzaBautizoImage, pos: 'object-[10%_center]', alt: 'Alabanza en bautizo' },
];
const posts = await getActivePosts();

const slides: Slide[] = posts.map(post => ({
  title: post.title,
  summary: post.summary || (post.content ? `${post.content.substring(0, 100)}...` : ''),
  type: post.type,
  target_url: post.target_url || '#',
}));
---

<BaseLayout 
  pageTitle="Inicio" 
  description="Bienvenidos a la IDP en Hijuelas. Un espacio de fe, amor y servicio donde vivimos juntos el llamado de Dios a través de la adoración y la unidad.">
  
  <Hero />
  <FeaturedCarousel slides={slides} />

  <!-- SECCIÓN DE SERVICIOS -->
  <section class="bg-white py-20 text-idp-azul">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <Carousel 
          images={images} 
          className="h-96 w-full rounded-3xl object-right shadow-md border-2 border-idp-dorado" 
        />
      </div>
      
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {services.map((service) => (
          <div
            class="rounded-3xl border border-idp-dorado/40 bg-idp-azul/5 p-8 shadow-lg transition hover:-translate-y-1 hover:shadow-2xl"
          >
            <!-- Titular con Aktiv Grotesk Ex -->
            <h3 class="font-heading text-2xl font-bold text-idp-azul mb-3">{service.title}</h3>
            <!-- Texto resaltado con Berkeley Oldstyle -->
            <p class="font-serif text-sm uppercase tracking-[0.28em] text-idp-rojo mb-4 font-semibold">{service.time}</p>
            <!-- Cuerpo de texto con Nunito Sans -->
            <p class="font-sans font-light text-slate-700 leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE VIDA COMUNITARIA -->
  <section class="bg-idp-azul py-20 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <!-- Texto resaltado con Berkeley Oldstyle -->
          <p class="font-serif text-sm uppercase tracking-[0.28em] text-idp-dorado font-semibold">Vida comunitaria</p>
          <!-- Titular con Aktiv Grotesk Ex -->
          <h2 class="font-heading mt-4 text-3xl font-bold sm:text-4xl text-white">Un espacio de amor y servicio</h2>
          <!-- Cuerpo de texto con Nunito Sans -->
          <p class="font-sans font-light mt-6 text-slate-200 leading-relaxed">
            Descubre cómo nuestras reuniones, ministerios y espacios de oración invitan a cada persona a vivir una fe auténtica y una comunidad cercana.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="/quienes-somos"
              class="inline-flex items-center justify-center rounded-full bg-idp-rojo px-6 py-3 font-sans font-bold text-white transition hover:opacity-90 shadow-md"
            >
              Conoce más
            </a>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center rounded-full border border-idp-dorado px-6 py-3 font-sans font-semibold text-idp-dorado transition hover:bg-idp-dorado/10"
            >
              Contáctanos
            </a>
          </div>
        </div>

        <div class="overflow-hidden relative rounded-3xl shadow-2xl ring-1 ring-idp-dorado/30">
          <Image
            src={bautizoImage}
            alt="Encuentro de hermanos en adoración"
            class="h-96 w-full object-cover object-right"
          />
          <div class="absolute inset-0 bg-idp-purpura/25 pointer-events-none"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE PRIORIDADES -->
  <section class="bg-idp-purpura/10 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center">
      <!-- Texto resaltado con Berkeley Oldstyle -->
      <p class="font-serif text-sm uppercase tracking-[0.28em] text-idp-rojo font-semibold">Nuestras prioridades</p>
      <!-- Titular con Aktiv Grotesk Ex -->
      <h2 class="font-heading mt-4 text-3xl font-bold text-idp-azul sm:text-4xl">Fe, servicio y comunidad</h2>
      <!-- Cuerpo de texto con Nunito Sans -->
      <p class="font-sans font-normal mx-auto mt-5 max-w-2xl text-slate-700 leading-relaxed">
        En cada actividad buscamos impactar vidas con la Palabra, la oración y un llamado a la unidad.
      </p>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl bg-white p-8 shadow-lg text-center border-t-4 border-idp-azul">
          <div class="mb-4 flex justify-center">
            <Image src={iconoAdoracion} alt="Adoración" class="w-32 h-32 object-contain" />
          </div>
          <!-- Titular con Aktiv Grotesk Ex -->
          <h3 class="font-heading text-2xl font-semibold text-idp-azul mb-3">Adoración</h3>
        </div>
        <div class="rounded-3xl bg-white p-8 shadow-lg text-center border-t-4 border-idp-purpura">
          <div class="mb-4 flex justify-center">
            <Oracion class="w-32 h-32 fill-idp-azul stroke-idp-dorado" />
          </div>
          <!-- Titular con Aktiv Grotesk Ex -->
          <h3 class="font-heading text-2xl font-semibold text-idp-azul mb-3">Oración</h3>
        </div>
        <div class="rounded-3xl bg-white p-8 shadow-lg text-center border-t-4 border-idp-rojo">
          <div class="mb-4 flex justify-center">
            <Servicio class="w-32 h-32 fill-idp-azul stroke-idp-dorado" />
          </div>
          <!-- Titular con Aktiv Grotesk Ex -->
          <h3 class="font-heading text-2xl font-semibold text-idp-azul mb-3">Servicio</h3>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>