---
// src/layouts/AdminLayout.astro
import '../styles/global.css';

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊' },
  { href: '/admin/contenido-destacado', label: 'Contenido destacado', icon: '📝' },
  { href: '/admin/eventos', label: 'Eventos', icon: '📅' },
  { href: '/admin/galeria', label: 'Galería', icon: '🖼️' },
  { href: '/admin/hitos-templo', label: 'Hitos del templo', icon: '⏳' },
];

const isActive = (path: string) => {
  if (path === '/admin') return currentPath === '/admin' ? 'bg-cyan-50 text-cyan-700 font-semibold border-cyan-200' : 'text-slate-600 hover:bg-slate-100 border-transparent';
  return currentPath.startsWith(path) ? 'bg-cyan-50 text-cyan-700 font-semibold border-cyan-200' : 'text-slate-600 hover:bg-slate-100 border-transparent';
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | IDP Hijuelas - Admin</title>
  </head>
  <body class="flex min-h-screen bg-slate-50">
    
    <!-- Sidebar Lateral Estilizado -->
    <aside class="w-72 border-r border-slate-200/80 bg-white p-6 hidden md:flex flex-col shadow-sm">
      <div class="mb-10 flex items-center gap-3 px-2">
        <div class="h-10 w-10 rounded-2xl bg-cyan-600 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-cyan-600/20">IDP</div>
        <div>
          <span class="block font-bold text-slate-900 leading-tight">IDP Hijuelas</span>
          <span class="text-[10px] uppercase tracking-[0.2em] text-slate-400 font-semibold">Admin Panel</span>
        </div>
      </div>

      <nav class="space-y-2 flex-1">
        {navItems.map(item => (
          <a href={item.href} class={`flex items-center gap-3 px-4 py-3 rounded-2xl border transition-all duration-200 text-sm ${isActive(item.href)}`}>
            <span class="text-base">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="mt-auto pt-6 border-t border-slate-100">
        <form action="/api/auth/signout" method="GET">
          <button type="submit" class="w-full text-left px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all">
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Contenido Principal -->
    <main class="flex-1 min-w-0 flex flex-col">
      <!-- Header Móvil -->
      <header class="md:hidden h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded-xl bg-cyan-600 flex items-center justify-center text-white font-bold text-xs">IDP</div>
          <span class="font-bold text-slate-900 text-sm">IDP Admin</span>
        </div>
        <form action="/api/auth/signout" method="GET">
          <button type="submit" class="text-xs font-semibold text-red-600 px-3 py-1.5 rounded-lg bg-red-50">Salir</button>
        </form>
      </header>
      
      <div class="p-6 md:p-10 flex-1 max-w-6xl w-full mx-auto">
        <slot />
      </div>
    </main>
  </body>
</html>